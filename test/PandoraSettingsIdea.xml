<pandora>
    <!-- GLOBAL SETTINGS -->
    <IsMonitoringEnabled>true</IsMonitoringEnabled>
    <ShouldDisplayAlgorithmInfo>true</ShouldDisplayAlgorithmInfo>
    <ShouldCollapseMCParticlesToPfoTarget>false</ShouldCollapseMCParticlesToPfoTarget>

    <algorithm type = "ExternalClustering">
        <FlagClustersAsPhotons>false</FlagClustersAsPhotons>
    </algorithm>

    <algorithm type = "TrackClusterAssociation">
        <LowEnergyCut>0.5</LowEnergyCut>
        <MaxTrackClusterDistance>3.</MaxTrackClusterDistance>
        <MaxSearchLayer>0</MaxSearchLayer>
        <ParallelDistanceCut>50.</ParallelDistanceCut>
        <MinTrackClusterCosAngle>0.</MinTrackClusterCosAngle>
    </algorithm>

    <algorithm type = "BremRecovery">
        <dEtaMargin>0.005</dEtaMargin>
        <dPhiMargin>0.05</dPhiMargin>
    </algorithm>

    <algorithm type = "CreatePfo">
        <OutputPfoListName>PfoIdea</OutputPfoListName>
    </algorithm>

</pandora>






